# ASTRO360 Environment Variables Template
# Server-side API keys (Never expose to client with VITE_ prefix)

# AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Space & External APIs
NASA_API_KEY=your_nasa_api_key_here
UMMAH_API_KEY=your_ummah_api_key_here
MUSLIM_API_KEY=your_muslim_api_key_here
KALIMAT_API_KEY=your_kalimat_api_key_here

# Cloud & Database (Supabase / InsForge)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Observability
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=your_sentry_dsn_here
