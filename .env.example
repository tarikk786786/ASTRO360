# ASTRO360 Environment Variables Template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored AND untracked —
# do not commit it, and do not paste key values into commit messages.
#
# ─────────────────────────────────────────────────────────────────────────────
# RULE: Server-side keys must NEVER carry a VITE_ prefix.
#
# Vite inlines every VITE_-prefixed variable into the browser bundle at build
# time, so a VITE_-prefixed key is a published key. Server-only values are read
# in `api/` functions via process.env. Only the two VITE_INSFORGE_* values at the
# bottom of this file are intentionally client-visible.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-only: AI providers ───────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Server-only: external data APIs (used by api/proxy.ts) ──────────────────
# NASA: omit to fall back to NASA's public DEMO_KEY (heavily rate limited).
NASA_API_KEY=
# Optional keyed prayer-time providers. The proxy uses keyless Aladhan first, so
# leaving these blank is fine and the feature still works.
UMMAH_API_KEY=
MUSLIM_API_KEY=
# Optional. Kalimat Arabic NLP features return 503 if this is absent.
KALIMAT_API_KEY=

# ── Server-only: payments (used by api/payment.ts) ──────────────────────────
# Get these from the Cashfree merchant dashboard. CASHFREE_ENV is 'sandbox' or 'production'.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Secret used to verify incoming Cashfree webhook signatures. Required in production —
# without it, webhook callbacks cannot be authenticated and are rejected.
CASHFREE_WEBHOOK_SECRET=

# ── Server-only: CORS ───────────────────────────────────────────────────────
# Comma-separated origins allowed to call /api/*. Defaults to the production
# domain plus localhost if unset.
ALLOWED_ORIGINS=https://astro.tarikislam.in,http://localhost:5173

# ── Client-visible (public by design — safe to expose) ──────────────────────
# Required: the app throws a clear configuration error at startup if these are unset.
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=
